# ============================================================
# BizManager — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must NEVER be committed.
# .env at the project root is also git-ignored — Prisma reads it.
#
# Variable naming:
#   NEXT_PUBLIC_*  — safe to expose to the browser (client-readable)
#   (no prefix)    — server-side only, NEVER exposed to the client
# ============================================================

# ─── Database ────────────────────────────────────────────────
# PostgreSQL connection string for Prisma.
# Local:  postgresql://postgres:password@localhost:5432/bizmanager
# Neon:   postgresql://user:pass@ep-xxx.neon.tech/bizmanager?sslmode=require
DATABASE_URL=""

# ─── Firebase Admin SDK (SERVER-SIDE ONLY) ───────────────────
# Never put these in NEXT_PUBLIC_* variables.
# Download from: Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Full PEM with \n for newlines:
# "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=""

# ─── Firebase Client SDK (PUBLIC — safe to expose) ───────────
# Copy from: Firebase Console → Project Settings → Your apps → Web
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ─── Application ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="BizManager"

# ─── Push Notifications (VAPID) — Phase 10 ───────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTACT_EMAIL=""

# ─── Session signing (REQUIRED) ──────────────────────────────
# Signs the server session cookie. Must be at least 32 characters of random
# data, unique per environment, and never committed. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# ─── Manual subscription billing ─────────────────────────────
# BizManager collects subscription payments manually (Telebirr / bank transfer);
# an administrator verifies each one. There is NO payment gateway. These values
# are shown to owners on the Subscription page. Placeholders only — never commit
# real secrets. Leave blank to show "payment details not configured".
BILLING_TELEBIRR_NUMBER=""
BILLING_TELEBIRR_NAME=""
BILLING_BANK_NAME=""
BILLING_BANK_ACCOUNT=""
BILLING_BANK_ACCOUNT_NAME=""

# Private Firebase Storage bucket for payment receipts (server-side only).
# Its security rules must deny all direct client reads/writes — see DEPLOYMENT.md.
FIREBASE_STORAGE_BUCKET=""

# ─── Optional: Prisma engine override ────────────────────────
# Uncomment if Prisma binary downloads are blocked on your network.
# PRISMA_CLI_QUERY_ENGINE_TYPE=library
# PRISMA_CLIENT_ENGINE_TYPE=library

# ─── Public site ─────────────────────────────────────────────
# Shown in the website footer and legal pages when set. Leave blank to hide.
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_SUPPORT_PHONE=""
