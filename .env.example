# ============================================================
# Business Management SaaS — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must NEVER be committed.
# .env at the project root is also git-ignored — Prisma reads it.
#
# Variable naming conventions:
#   NEXT_PUBLIC_*  — safe to expose to the browser (client-readable)
#   (no prefix)    — server-side only, NEVER exposed to the client
# ============================================================

# ─── Database ────────────────────────────────────────────────
# PostgreSQL connection string for Prisma.
# Local:  postgresql://postgres:password@localhost:5432/bizmanager
# Neon:   postgresql://user:pass@ep-xxx.neon.tech/bizmanager?sslmode=require
DATABASE_URL=""

# ─── Firebase Admin SDK ──────────────────────────────────────
# SERVER-SIDE ONLY. Never put these in NEXT_PUBLIC_* variables.
# Download the service account JSON from:
#   Firebase Console → Project Settings → Service Accounts → Generate new private key
# Then copy the individual fields below.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# The private key must include the full PEM block.
# In .env.local, replace actual newlines with \n, e.g.:
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=""

# ─── Firebase Client SDK ─────────────────────────────────────
# PUBLIC — safe to expose to the browser.
# Copy from: Firebase Console → Project Settings → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ─── Application ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="BizManager"

# ─── Push Notifications (VAPID) ──────────────────────────────
# Used in Phase 10 (push notifications).
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTACT_EMAIL=""

# ─── Optional: Prisma engine override ────────────────────────
# Uncomment if Prisma binary downloads are blocked on your network.
# PRISMA_CLI_QUERY_ENGINE_TYPE=library
# PRISMA_CLIENT_ENGINE_TYPE=library
