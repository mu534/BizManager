# ============================================================
# Business Management SaaS — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must NEVER be committed.
#
# Variable naming conventions:
#   NEXT_PUBLIC_*  — safe to expose to the browser
#   (no prefix)    — server-side only, never sent to the client
# ============================================================

# ─── Database ────────────────────────────────────────────────
# PostgreSQL connection string for Prisma.
# For local dev: postgresql://postgres:password@localhost:5432/bizmanager
# For Neon:      postgresql://user:pass@ep-xxx.neon.tech/bizmanager?sslmode=require
DATABASE_URL=""

# ─── Firebase Admin SDK (SERVER-SIDE ONLY) ───────────────────
# These credentials must NEVER be in a NEXT_PUBLIC_ variable.
# Download from Firebase Console → Project Settings → Service Accounts.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Private key — include the full PEM including newlines as \n
# Example: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=""

# ─── Firebase Client SDK (PUBLIC — safe to expose) ───────────
# Copy from Firebase Console → Project Settings → Your apps → Web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ─── Application ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="BizManager"

# ─── Push Notifications (VAPID) ──────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact email for VAPID (used in push notification headers)
VAPID_CONTACT_EMAIL=""

# ─── Optional: Prisma binary configuration ───────────────────
# Uncomment if Prisma binary downloads are blocked on your network.
# PRISMA_CLI_QUERY_ENGINE_TYPE=library
# PRISMA_CLIENT_ENGINE_TYPE=library
